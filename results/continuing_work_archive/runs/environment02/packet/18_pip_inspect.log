      "metadata": {
        "metadata_version": "2.4",
        "name": "pyrevolve",
        "version": "2.2.8",
        "dynamic": [
          "author",
          "author-email",
          "classifier",
          "description",
          "description-content-type",
          "home-page",
          "license",
          "license-file",
